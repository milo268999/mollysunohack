    // Vẽ biểu đồ sóng
    function drawWaveform(data, color) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.strokeStyle = color;
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      const step = Math.ceil(data.length / canvas.width);
      const amp = canvas.height / 2;
      for (let i = 0; i < canvas.width; i++) {
        let min = 1.0, max = -1.0;
        for (let j = 0; j < step; j++) {
          const datum = data[(i * step) + j] || 0;
          if (datum < min) min = datum;
          if (datum > max) max = datum;
        }
        ctx.moveTo(i, (1 + min) * amp);
        ctx.lineTo(i, (1 + max) * amp);
      }
      ctx.stroke();
    }

    // Hàm thực thi 13 tầng DSP
    async function processAudio() {
      if (!originalAudioBuffer) return;
      processBtn.disabled = true;
      downloadLink.style.display = 'none';

      try {
        logStatus("⚙️ Đang khởi chạy chuỗi 13 thuật toán DSP...");
        await new Promise(r => setTimeout(r, 50));

        const sr = originalAudioBuffer.sampleRate;
        let tStart = parseFloat(document.getElementById('trimStart').value) || 0;
        let tEnd = parseFloat(document.getElementById('trimEnd').value) || originalAudioBuffer.duration;
        if (tEnd <= tStart || tEnd > originalAudioBuffer.duration) tEnd = originalAudioBuffer.duration;

        const startSample = Math.floor(tStart * sr);
        const endSample = Math.floor(tEnd * sr);
        const sliceLen = endSample - startSample;

        // Lấy kênh Left & Right
        const srcL = originalAudioBuffer.getChannelData(0).subarray(startSample, endSample);
        const srcR = originalAudioBuffer.numberOfChannels > 1
          ? originalAudioBuffer.getChannelData(1).subarray(startSample, endSample)
          : srcL;

        // Đọc 13 tham số
        const pitchSemitones = parseFloat(document.getElementById('p_pitch').value);
        const tempoRatio = parseFloat(document.getElementById('p_tempo').value) / 100.0;
        const lfoDepthMs = parseFloat(document.getElementById('p_lfoDepth').value);
        const lfoRateHz = parseFloat(document.getElementById('p_lfoRate').value);
        const haasMs = parseFloat(document.getElementById('p_haas').value);
        const midGainLinear = Math.pow(10, parseFloat(document.getElementById('p_midGain').value) / 20);
        const sideWidthRatio = parseFloat(document.getElementById('p_sideWidth').value) / 100.0;
        const allpassStages = parseInt(document.getElementById('p_allpass').value, 10);
        const notchGainDb = parseFloat(document.getElementById('p_notch').value);
        const asrGainDb = parseFloat(document.getElementById('p_asr').value);
        const transientAmount = parseFloat(document.getElementById('p_transient').value) / 100.0;
        const driveAmount = parseFloat(document.getElementById('p_drive').value) / 100.0;
        const noiseDb = parseFloat(document.getElementById('p_noise').value);

        // Bước 1: Chèn 0.8s Ambient Offset đầu bài + Tính độ dài mới sau Tempo Stretch
        const padSamples = Math.floor(0.8 * sr);
        const stretchedLen = Math.floor(sliceLen / tempoRatio);
        const totalLen = padSamples + stretchedLen;

        const outL = new Float32Array(totalLen);
        const outR = new Float32Array(totalLen);

        // Bước 2: Time-Stretching + LFO Non-Linear Time Warping
        const lfoDepthSamples = (lfoDepthMs / 1000.0) * sr;
        let readPos = 0;
        for (let i = 0; i < stretchedLen; i++) {
          const t = i / sr;
          const lfoOffset = Math.sin(2 * Math.PI * lfoRateHz * t) * lfoDepthSamples
                          + 0.4 * Math.cos(2 * Math.PI * (lfoRateHz * 1.618) * t) * lfoDepthSamples;
          let idx = readPos + lfoOffset;
          if (idx < 0) idx = 0;
          if (idx >= sliceLen - 2) idx = sliceLen - 2;

          const i0 = Math.floor(idx);
          const frac = idx - i0;
          outL[padSamples + i] = srcL[i0] * (1 - frac) + srcL[i0 + 1] * frac;
          outR[padSamples + i] = srcR[i0] * (1 - frac) + srcR[i0 + 1] * frac;

          readPos += tempoRatio;
        }

        // Tạo hiệu ứng mồi mềm ở 0.8s đầu bài để phá vỡ cửa sổ FFT đầu tiên
        for (let i = 0; i < padSamples; i++) {
          const env = Math.pow(i / padSamples, 2) * 0.08;
          const srcIdx = Math.min(i, sliceLen - 1);
          outL[i] = srcL[srcIdx] * env;
          outR[i] = srcR[srcIdx] * env;
        }

        // Bước 3: Dual-Tap Granular Pitch Shifter (Dịch Pitch độc lập với Tempo)
        const pitchFactor = Math.pow(2, pitchSemitones / 12.0) / tempoRatio;
        if (Math.abs(pitchFactor - 1.0) > 0.001) {
          const grainSize = Math.floor(0.035 * sr); // 35ms window
          const bufL = new Float32Array(outL);
          const bufR = new Float32Array(outR);
          let phase1 = 0;
          let phase2 = 0.5;
          const rate = (1.0 - pitchFactor) / grainSize;

          for (let i = 0; i < totalLen; i++) {
            phase1 += rate;
            if (phase1 >= 1.0) phase1 -= 1.0;
            if (phase1 < 0.0) phase1 += 1.0;

            phase2 = phase1 + 0.5;
            if (phase2 >= 1.0) phase2 -= 1.0;

            const delay1 = phase1 * grainSize;
            const delay2 = phase2 * grainSize;

            const win1 = 0.5 * (1.0 - Math.cos(2 * Math.PI * phase1));
            const win2 = 0.5 * (1.0 - Math.cos(2 * Math.PI * phase2));

            const readSample = (arr, pos) => {
              if (pos < 0) return 0;
              if (pos >= totalLen - 2) return arr[totalLen - 1];
              const idx = Math.floor(pos);
              const f = pos - idx;
              return arr[idx] * (1 - f) + arr[idx + 1] * f;
            };

            outL[i] = readSample(bufL, i - delay1) * win1 + readSample(bufL, i - delay2) * win2;
            outR[i] = readSample(bufR, i - delay1) * win1 + readSample(bufR, i - delay2) * win2;
          }
        }

        // Bước 4: Mid-Side (M/S) Encoding, Transient Smearing, Tube Saturation & Pink Noise
        const noiseAmp = Math.pow(10, noiseDb / 20);
        let b0 = 0, b1 = 0, b2 = 0; // Bộ lọc Pink Noise
        let envFollowerL = 0, envFollowerR = 0;
        const driveK = 1 + driveAmount * 2.5;
        const normDrive = Math.tanh(driveK);

        for (let i = 0; i < totalLen; i++) {
          let l = outL[i];
          let r = outR[i];

          // Transient Smearing (Làm mềm đỉnh xung trống)
          if (transientAmount > 0) {
            const diffL = l - envFollowerL;
            const diffR = r - envFollowerR;
            envFollowerL += diffL * 0.15;
            envFollowerR += diffR * 0.15;
            if (Math.abs(diffL) > 0.25) l -= diffL * transientAmount * 0.45;
            if (Math.abs(diffR) > 0.25) r -= diffR * transientAmount * 0.45;
          }

          // Tách Mid / Side
          let mid = 0.5 * (l + r) * midGainLinear;
          let side = 0.5 * (l - r) * sideWidthRatio;

          l = mid + side;
          r = mid - side;

          // Harmonic Tube Saturation
          if (driveAmount > 0) {
            l = Math.tanh(l * driveK) / normDrive;
            r = Math.tanh(r * driveK) / normDrive;
          }

          // Sub-audible Pink Noise Masking
          const white = (Math.random() * 2 - 1);
          b0 = 0.99765 * b0 + white * 0.0990460;
          b1 = 0.96300 * b1 + white * 0.2965164;
          b2 = 0.57000 * b2 + white * 1.0526913;
          const pink = (b0 + b1 + b2 + white * 0.1848) * 0.05;

          outL[i] = l + pink * noiseAmp;
          outR[i] = r - pink * noiseAmp; // Ngược pha nhiễu để tự triệt tiêu khi nghe Mono
        }

        // Bước 5: Haas Stereo Micro-Delay (Làm trễ kênh Right để tạo bẫy gộp Mono)
        const haasSamples = Math.floor((haasMs / 1000.0) * sr);
        if (haasSamples > 0) {
          for (let i = totalLen - 1; i >= haasSamples; i--) {
            outR[i] = outR[i - haasSamples];
          }
        }

        // Bước 6: Đưa vào OfflineAudioContext để chạy All-Pass Phase Dispersion, Multi-Notch & ASR Filter
        const offlineCtx = new OfflineAudioContext(2, totalLen, sr);
        const procBuffer = offlineCtx.createBuffer(2, totalLen, sr);
        procBuffer.copyToChannel(outL, 0);
        procBuffer.copyToChannel(outR, 1);

        const sourceNode = offlineCtx.createBufferSource();
        sourceNode.buffer = procBuffer;

        let currentNode = sourceNode;

        // Cắt Sub-Bass rác dưới 28Hz
        const hpFilter = offlineCtx.createBiquadFilter();
        hpFilter.type = 'highpass';
        hpFilter.frequency.value = 28;
        currentNode.connect(hpFilter);
        currentNode = hpFilter;

        // Chuỗi All-Pass Phase Scrambling
        const allpassFreqs = [340, 890, 1850, 3100, 4600, 6800];
        for (let s = 0; s < allpassStages; s++) {
          const ap = offlineCtx.createBiquadFilter();
          ap.type = 'allpass';
          ap.frequency.value = allpassFreqs[s];
          ap.Q.value = 4.5;
          currentNode.connect(ap);
          currentNode = ap;
        }

        // 4 Khe Multi-Notch xóa đỉnh phổ Fingerprint
        const notchFreqs = [680, 1420, 2380, 3750];
        for (let f of notchFreqs) {
          const peakingNotch = offlineCtx.createBiquadFilter();
          peakingNotch.type = 'peaking';
          peakingNotch.frequency.value = f;
          peakingNotch.Q.value = 18.0;
          peakingNotch.gain.value = notchGainDb;
          currentNode.connect(peakingNotch);
          currentNode = peakingNotch;
        }

        // Bộ lọc làm mờ phụ âm chống Whisper ASR quét lời
        const asrFilter = offlineCtx.createBiquadFilter();
        asrFilter.type = 'peaking';
        asrFilter.frequency.value = 3950;
        asrFilter.Q.value = 1.6;
        asrFilter.gain.value = asrGainDb;
        currentNode.connect(asrFilter);
        currentNode = asrFilter;

        currentNode.connect(offlineCtx.destination);
        sourceNode.start(0);

        const renderedBuffer = await offlineCtx.startRendering();

        // Bước 7: Chuẩn hóa biên độ an toàn (Peak Normalization @ -0.6 dBFS)
        const finalL = renderedBuffer.getChannelData(0);
        const finalR = renderedBuffer.getChannelData(1);
        let maxPeak = 0;
        for (let i = 0; i < totalLen; i++) {
          const absL = Math.abs(finalL[i]);
          const absR = Math.abs(finalR[i]);
          if (absL > maxPeak) maxPeak = absL;
          if (absR > maxPeak) maxPeak = absR;
        }
        if (maxPeak > 0.001) {
          const targetGain = 0.93 / maxPeak;
          for (let i = 0; i < totalLen; i++) {
            finalL[i] *= targetGain;
            finalR[i] *= targetGain;
          }
        }

        drawWaveform(finalL, '#00e676');

        // Bước 8: Đóng gói file WAV 16-bit sạch 100% Metadata
        processedWavBlob = encodeWAV(finalL, finalR, sr);
        const wavUrl = URL.createObjectURL(processedWavBlob);
        processedPlayer.src = wavUrl;

        downloadLink.href = wavUrl;
        downloadLink.download = `${originalFileName}_SunoBypass_v6.wav`;
        downloadLink.style.display = 'block';

        logStatus(
          `🎉 HOÀN TẤT XỬ LÝ 13 TẦNG DSP!\n` +
          `• Độ dài xuất ra: ${(totalLen / sr).toFixed(1)}s | Sạch 100% Metadata & ISRC\n` +
          `• Đã áp dụng: Pitch (${pitchSemitones}st), Tempo (${(tempoRatio*100).toFixed(1)}%), LFO Warp (${lfoDepthMs}ms), Haas Mono-Trap (${haasMs}ms), ${allpassStages} tầng All-Pass & Chống quét lời ASR.\n` +
          `👉 Hãy nghe thử ở mục số 3 hoặc bấm nút TẢI FILE .WAV về để đưa lên Suno!`
        );
      } catch (err) {
        logStatus(`❌ Lỗi trong quá trình xử lý: ${err.message}`);
      } finally {
        processBtn.disabled = false;
      }
    }

    // Bộ đóng gói PCM WAV sạch không chứa bất kỳ thẻ ID3/ISRC bản quyền nào
    function encodeWAV(samplesL, samplesR, sampleRate) {
      const numChannels = 2;
      const length = samplesL.length * numChannels * 2;
      const buffer = new ArrayBuffer(44 + length);
      const view = new DataView(buffer);

      const writeString = (offset, str) => {
        for (let i = 0; i < str.length; i++) {
          view.setUint8(offset + i, str.charCodeAt(i));
        }
      };

      writeString(0, 'RIFF');
      view.setUint32(4, 36 + length, true);
      writeString(8, 'WAVE');
      writeString(12, 'fmt ');
      view.setUint32(16, 16, true);
      view.setUint16(20, 1, true); // PCM
      view.setUint16(22, numChannels, true);
      view.setUint32(24, sampleRate, true);
      view.setUint32(28, sampleRate * numChannels * 2, true);
      view.setUint16(32, numChannels * 2, true);
      view.setUint16(34, 16, true); // 16-bit
      writeString(36, 'data');
      view.setUint32(40, length, true);

      let offset = 44;
      for (let i = 0; i < samplesL.length; i++) {
        let sL = Math.max(-1, Math.min(1, samplesL[i]));
        let sR = Math.max(-1, Math.min(
